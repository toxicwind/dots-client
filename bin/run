#!/usr/bin/env bash
# dots-client — alternate model-call shim (Dots-3-Note) autonomous rig (bin/run).
# Primary operation: the shim module is a library. bin/run executes it as a
# self-test harness: compiles the module and, if the `openai` runtime dep is
# installed, constructs the client with a placeholder key (no network calls).
# Usage: bin/run
set -euo pipefail
cd "$(dirname "$0")/.."

pybin="$(command -v python3 2>/dev/null || echo /usr/bin/python3)"

echo "== dots-client run: module self-test =="
"$pybin" -m py_compile estate_dots_client.py || { echo "FAIL: module does not compile"; exit 1; }

if ! "$pybin" -c "import openai" 2>/dev/null; then
  echo "WARN: 'openai' runtime dep not installed. The shim cannot construct a client."
  echo "      Install with: pip install openai   (repo has no requirements/pyproject manifest)."
  echo "      Compile gate above passed; see bin/check. Exit 0."
  exit 0
fi

"$pybin" -c "
import sys; sys.path.insert(0, '.')
from estate_dots_client import estate_scripts_dots_client as C
C(api_key='REDACTED-PLACEHOLDER')
print('OK: estate_scripts_dots_client constructed')
"
echo "OK: dots-client module healthy"